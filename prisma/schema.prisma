// Hours Back — prospect store. Conventions (cuid ids, @unique, @default,
// explicit @relation) copied from BuilderPath's proven schema at
// Veristone/builderflow/prisma/schema.prisma, per the lb2 record-shape spec.
//
// SQLite for now (single operator, zero setup); Prisma enums are not
// supported on SQLite, so stage carries the six ladder values as strings —
// the value vocabulary is enforced by scripts/hoursback/run-spec-checks.js,
// matching builderflow's ProspectStage equivalents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres on Supabase — Russ's existing "VisionAIry CRM" project. Chosen
  // 2026-08-25 over a paid disk: data lives free and permanent in Supabase,
  // so the app itself can run on a free tier that keeps nothing.
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One Central Oregon business. The generated id is the record's identity —
/// placeId is unique but MAY change if Google re-lists the business, and the
/// record must survive that (round-trip check: id unchanged on placeId edit).
///
/// Every machine-written (fetched) field has a paired hand-entered column
/// beside it (...ManualValue): the fetched value and the typed value occupy
/// separate columns, a correction never overwritten by a later sweep. The
/// resolved value is ManualValue when present, fetched otherwise.
model Prospect {
  id     String  @id @default(cuid())
  placeId String @unique

  // --- capture fields (machine-written) + their hand-entered pairs --------
  name              String
  nameManualValue   String?
  phone             String?
  phoneManualValue  String?
  website           String?
  websiteManualValue String?
  address           String?
  addressManualValue String?
  normalizedPhone   String?
  normalizedDomain  String?

  // --- enrichment fields (machine-written) + their hand-entered pairs -----
  employeeCount            Int?
  employeeCountManualValue Int?
  headcountSourceUrl       String?
  headcountStatus          String?
  email                    String?
  emailManualValue         String?
  emailConfidence          Float?
  emailStatus              String?

  headcountPublishedAs     String?   // "8-20" when the site published a range

  // --- read from the business's own website (free: no key, no fee) --------
  // siteStatus: READ | NO_WEBSITE | UNREACHABLE. scoreEvidence is the list of
  // tells behind the score - which signal, what it is worth, where it was
  // seen - so the number is never a black box on the call screen.
  siteStatus      String?
  siteReadAt      DateTime?
  linkedInUrl     String?   // the business's own LinkedIn page, from their site
  selfDescription String?   // the one line they wrote about themselves
  trade           String?   // settled from their own words when the name could not
  yearsInBusiness Int?      // "since 1994" — an opener that writes itself
  toolsInUse      String?   // what they already pay for, which says what is missing
  openRoles       Int?      // how many office roles they are advertising
  automationScore Int?
  scoreEvidence   String?

  // --- derived from the RESOLVED employeeCount via the rules module -------
  // (recomputed on an employeeCount correction; never a per-employee figure)
  segment         String?
  auditFee        Int?
  guaranteedHours Int?

  // --- provenance ---------------------------------------------------------
  captureRunId String?
  captureRun   CaptureRun? @relation(fields: [captureRunId], references: [id])
  fieldSource  String?
  fetchedAt    DateTime?

  // --- working state (vocabulary enforced in code; sqlite has no enums) ---
  // stage values: NO_CONTACT, NEEDS_REVIEW (no phone or website — the operator
  // confirms before it is worked), then the CRM ladder INITIAL_CONTACT, ACTIVE,
  // IN_PROCESS, CUSTOMER, EXPANDED_CUSTOMER, and DORMANT after the give-up rule.
  stage        String  @default("NO_CONTACT")
  doNotContact Boolean @default(false)

  // --- the frozen quote (crm1): written once, never recomputed, so a later
  // headcount change can never alter a promise already made -----------------
  quotedAt              DateTime?
  quotedHeadcount       Int?
  quotedBand            String?
  quotedAuditFee        Int?
  quotedGuaranteedHours Int?

  // --- who was actually spoken to (crm1) ----------------------------------
  contactName     String?
  contactRole     String?
  isDecisionMaker Boolean?   // null = unknown; distinguishable from "no"
  ownerName       String?

  // --- money, separate from stage (crm1): CUSTOMER can exist unpaid -------
  paidAt DateTime?

  // --- the calling day (crm2/crm3) ----------------------------------------
  attemptCount    Int       @default(0)
  nextAction      String?
  nextActionDate  DateTime?
  lostReason      String?
  reactivateAfter DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldEdits      ProspectFieldEdit[]
  duplicatesKept  ProspectDuplicate[] @relation("keptProspect")
  callLogs        CallLog[]
  messages        OutreachMessage[]
  contacts        Contact[]

  // --- the email lane -----------------------------------------------------
  emailBouncedAt DateTime?   // suppressed on email only; the phone lane is untouched
  repliedAt      DateTime?   // a reply anywhere stops every queued message everywhere
}

/// One dial, appended forever — never overwritten. outcome is the per-dial
/// axis (NO_ANSWER, VOICEMAIL, GATEKEEPER, WRONG_NUMBER, NOT_INTERESTED,
/// INTERESTED) and never moves the stage by itself.
model CallLog {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  callKey    String?  @unique // idempotency: the same call logged twice writes one row
  outcome    String
  wentHow    String?
  nextWhat   String?
  nextWhen   DateTime?
  loggedAt   DateTime @default(now())
}

/// A business the sweep re-found. The kept prospect stays; the candidate is
/// recorded here instead of inserted, with the signal that matched.
model ProspectDuplicate {
  id              String   @id @default(cuid())
  keptProspectId  String
  keptProspect    Prospect @relation("keptProspect", fields: [keptProspectId], references: [id])
  candidatePlaceId String?
  candidateName    String?
  matchSignal      String   // "phone" | "domain" | "name_address"
  createdAt        DateTime @default(now())
}

/// One sweep. mode separates the one-time regional capture from the monthly
/// top-up; a resumed sweep re-requests no completed cell.
model CaptureRun {
  id             String    @id @default(cuid())
  mode           String    // "regional" | "monthly_top_up"
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  cellsAttempted Int       @default(0)
  cellsCompleted Int       @default(0)
  placesSeen     Int       @default(0)
  placesInserted Int       @default(0)
  prospects      Prospect[]
}

/// Append-only history of hand corrections: which field, the value before,
/// the value after, who corrected it and when.
model ProspectFieldEdit {
  id          String   @id @default(cuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id])
  fieldName   String
  valueBefore String?
  valueAfter  String?
  correctedBy String
  correctedAt DateTime @default(now())
}


/// The message Russ approves ONCE. Every first-contact email is a copy of this
/// with the business's own facts slotted in, and nothing else changed. Until
/// approvedAt is set, nothing on the email lane can send.
model MessageTemplate {
  id         String    @id @default(cuid())
  name       String    @unique   // "first_contact"
  subject    String
  body       String
  version    Int       @default(1)
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   OutreachMessage[]
}

/// One message, on one lane, to one business. Written, never overwritten.
/// lane:  PHONE | EMAIL | LINKEDIN
/// state: DRAFT | QUEUED | SENT | REPLIED | SUPPRESSED
/// A LinkedIn message can only reach SENT through a person's hand, recorded in
/// sentBy — the engine may never write it.
model OutreachMessage {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  lane       String
  state      String   @default("DRAFT")
  subject    String?
  body       String
  openedWith String?  // which tell this message led with
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  queuedAt   DateTime?
  sentAt     DateTime?
  sentBy     String?  // a person's name for LinkedIn; "engine" for email
  repliedAt  DateTime?
  suppressedReason String?
  createdAt  DateTime @default(now())

  @@index([prospectId, lane])
  @@index([state])
}


/// A person at a business. The website reader finds them; Russ corrects them.
/// Several per business is the normal case — a shared inbox, an owner, and
/// whoever answers the phone are three different things.
///
/// source: WEBSITE | RUSS | CALL
model Contact {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  name       String?
  role       String?
  email      String?
  phone      String?
  linkedIn   String?
  source     String   @default("WEBSITE")
  foundOn    String?  // the page it was read from
  isPrimary  Boolean  @default(false)
  bouncedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([prospectId, email])
  @@index([prospectId])
}
